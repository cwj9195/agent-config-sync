{
  "name": "zentao-11-3-local",
  "version": "1.0.5-local.1",
  "description": "本地维护的 ZenTao 11.3 Legacy MCP，兼容原工具协议并提供会话续期与可配置超时",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-zentao-11-3": "dist/index.js"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test:smoke": "node test/zentaoLegacyApi.smoke.mjs && node test/mcpProtocol.smoke.mjs",
    "watch": "tsc -w",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "zentao",
    "禅道",
    "11.3",
    "legacy",
    "session-api",
    "mcp-server",
    "model-context-protocol"
  ],
  "author": "maxenlin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxenLin/mcp-zentao-11-3.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
